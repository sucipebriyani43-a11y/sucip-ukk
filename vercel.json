{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/config/(.*)",
      "status": 403
    },
    {
      "src": "/(.*).sql",
      "status": 403
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}